{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["gru1"],
  "functions": {
    "api/server.js": {
      "maxDuration": 180,
      "includeFiles": "{backend/data/**,frontend/public/models/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/socket.io/:path*", "destination": "/api/server" },
    { "source": "/openapi.json", "destination": "/api/server" },
    { "source": "/api-docs/:path*", "destination": "/api/server" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
