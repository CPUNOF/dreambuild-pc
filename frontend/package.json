{
  "name": "@dreambuild/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e",
    "test:e2e": "node ../scripts/e2e.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cy:full": "cypress run --e2e --config-file cypress.fullstack.config.js",
    "test:e2e:full": "node ../scripts/e2e.mjs --full",
    "cy:open:full": "node ../scripts/e2e.mjs --full --open"
  },
  "dependencies": {
    "@firebase/app": "^0.16.4",
    "@firebase/auth": "^1.13.8",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cypress": "^15.21.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
