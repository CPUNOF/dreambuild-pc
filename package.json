{
  "name": "dreambuild-pc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names API,SITE --prefix-colors cyan,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "test": "npm test --workspace backend",
    "build": "npm run build --workspace frontend",
    "preview:local": "node --env-file-if-exists=backend/.env scripts/previewLocal.js",
    "format": "prettier --write \"backend/{src,scripts,data,test}/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" frontend/vite.config.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10"
  }
}
